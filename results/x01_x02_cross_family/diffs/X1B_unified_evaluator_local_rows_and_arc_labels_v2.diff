+def _xfam_local_dataset(path, dataset_name):
+    """XFAM X1 option B: our population rows -> HF schema of openbookqa / ai2_arc, split 'test'. answerKey is a constant placeholder "A" (no gold)."""
+    import json as _json
+    from datasets import Dataset, DatasetDict
+    recs = []
+    for line in open(path):
+        if not line.strip():
+            continue
+        r = _json.loads(line); q = r["query"]
+        # answerKey: constant placeholder "A" (NOT gold). The evaluator skips rows whose answerKey is not A-D; its own is_correct is unused.
+        rec = {"id": r["id"], "choices": {"text": list(q["choice_text"]), "label": list(q["choice_labels"])}, "answerKey": "A"}
+        rec["question_stem" if dataset_name == "openbookqa" else "question"] = q["question_stem"]
+        recs.append(rec)
+    return DatasetDict({"test": Dataset.from_list(recs)})
+

+mpiexec -n 2 --ppn 1 --hostfile "$PBS_NODEFILE" --cpu-bind none \
+  bash "$NEW/src/ClusterA/node_r1_ClusterA.sh" "$R1_DEADLINE_EPOCH" "${PBS_JOBID:-none}"
+echo "MPIEXEC_EXIT=$? JOB_END_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$LOG/job_env.txt"

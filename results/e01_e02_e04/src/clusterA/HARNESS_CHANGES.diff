+#!/bin/bash
+# [scheduler directive removed for anonymity]
+# [scheduler directive removed for anonymity]
+# [scheduler directive removed for anonymity]
+# [scheduler directive removed for anonymity]
+# [scheduler directive removed for anonymity]
+# P2_R1_EXP on ClusterA (DEVIATIONS.md D3): one 2-node debug job, 4 A100-40GB per node, one shell per node.
+# Submit: submit-job  -q debug -l select=2 -l walltime=00:55:00 -l fsreq=<fs> -N P2R1_E1E4_POL run_r1_ClusterA.pbs
+# Per-node GPU chains: node_r1_ClusterA.sh. analyze_r1.py is NOT run in this job.
+set -uo pipefail
+NEW=$DATA_DIR/P2_R1_EXP_20260919T050555Z
+LOG="$NEW/logs/ClusterA"
+START=$(date +%s)
+# Stop rule as frozen (drivers stop cleanly before each request/prefill), scaled to the 55-min walltime: start + 50 min
+R1_DEADLINE_EPOCH=$((START + 55 * 60 - 5 * 60))
+mkdir -p "$LOG"
+{
+  echo "JOB_START_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ) head=$(hostname) PBS_JOBID=${PBS_JOBID:-none} deadline_epoch=$R1_DEADLINE_EPOCH"
+  echo "PBS_NODEFILE:"; cat "$PBS_NODEFILE"
